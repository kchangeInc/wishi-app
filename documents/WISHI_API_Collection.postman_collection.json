								"body": {
									"mode": "raw",
									"raw": "{\n    \"title\": \"Honda City 2020\",\n    \"display_title\": \"Looking for Honda City 2020\",\n    \"description\": \"Single owner, well maintained, under 50K km\",\n    \"category_id\": 1,\n    \"subcategory_id\": 1,\n    \"filters_json\": {\n        \"min_price\": 500000,\n        \"max_price\": 900000,\n        \"location\": \"Mumbai\"\n    },\n    \"notes\": \"Prefer petrol variant\",\n    \"status\": \"active\",\n    \"priority\": \"high\",\n    \"field_values\": [\n        {\"field_definition_id\": 1, \"value\": \"Honda\"},\n        {\"field_definition_id\": 2, \"value\": \"City\"}\n    ],\n    \"preferred_marketplace_ids\": [1, 2]\n}"
