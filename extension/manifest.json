{
  "manifest_version": 3,
  "name": "Deal Platform Importer",
  "version": "1.0.0",
  "description": "Import seller listings from websites into the deal platform.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import listing"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
